# Copy to .env and fill in. Every variable here has a matching key in the runtimeConfig
# block of nuxt.config.ts; nothing in the app reads process.env directly.
#
# The connection values below already point at the local Supabase Docker stack. For the
# two keys, run `npm run db:start` then `npm run db:status` and paste in the printed
# publishable and secret keys. No dashboard is needed for local development.

# --- Supabase (owned by the @nuxtjs/supabase module) ---------------------------------
# Publishable key: safe in the browser, RLS applies.
NUXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NUXT_PUBLIC_SUPABASE_KEY=""
# Secret key: server only, bypasses RLS. Supabase's JWT signing keys replaced the older
# service key, so this is `secretKey` in the module config, not `serviceKey`.
NUXT_SUPABASE_SECRET_KEY=""

# --- Postgres connections -------------------------------------------------------------
# Three different targets; using the wrong one causes confusing failures. See
# docs/architecture.md.
#
# Session mode, for the Drizzle admin client on a persistent Node process.
NUXT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Direct connection on 5432, for migrations only. Locally these are the same host.
NUXT_DIRECT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Stripe (Phase 4) -----------------------------------------------------------------
NUXT_STRIPE_SECRET_KEY=""
NUXT_STRIPE_WEBHOOK_SECRET=""
NUXT_STRIPE_PRICE_PRO_MONTHLY=""
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Resend (Phase 2) -----------------------------------------------------------------
NUXT_RESEND_API_KEY=""
NUXT_EMAIL_FROM="Tradelog <onboarding@resend.dev>"

# --- Market data (Phase 5) ------------------------------------------------------------
# Proxied through Nitro so the key never reaches the browser.
NUXT_MARKET_DATA_API_KEY=""

# --- Site -----------------------------------------------------------------------------
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
